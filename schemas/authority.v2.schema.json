{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Volunteer decision authority v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "approval_reference",
    "reviewers",
    "fallbacks",
    "response_period_days",
    "routes",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "enabled": {
      "type": "boolean"
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reviewers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,128}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "empty": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "response_period_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "notes": {
      "type": "string"
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/step"
        }
      }
    }
  },
  "$defs": {
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_user_id",
        "availability",
        "verified_at",
        "approval_reference",
        "actions",
        "destinations",
        "escalation_approvers"
      ],
      "properties": {
        "github_user_id": {
          "type": "integer",
          "minimum": 1
        },
        "availability": {
          "enum": [
            "available",
            "absent",
            "unknown",
            "conflict"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_reference": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "enum": [
              "accept",
              "decline",
              "request_information",
              "refer",
              "agree_referral",
              "decline_referral",
              "request_escalation",
              "approve_escalation",
              "reject_escalation",
              "withdraw",
              "begin_onboarding",
              "request_invitation",
              "record_invitation_sent",
              "record_invitation_accepted",
              "complete_onboarding",
              "close"
            ]
          },
          "uniqueItems": true
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "escalation_approvers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "reviewer",
        "approval_reference"
      ],
      "properties": {
        "role": {
          "enum": [
            "team_reviewer",
            "repository_maintainer",
            "repository_lead",
            "parent_team_reviewer",
            "organization_fallback"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "approval_reference": {
          "type": "string",
          "minLength": 1
        },
        "fallback_approved": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "approval_reference": {
            "type": "string",
            "minLength": 1
          },
          "reviewers": {
            "minProperties": 1
          },
          "response_period_days": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "approval_reference": {
            "type": "null"
          },
          "reviewers": {
            "maxProperties": 0
          },
          "routes": {
            "maxProperties": 0
          },
          "fallbacks": {
            "maxProperties": 0
          },
          "response_period_days": {
            "type": "null"
          }
        }
      }
    }
  ]
}
